{
  "description": "Keep Windows awake and automatically close selected windows after a scheduled duration.",
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "license": "MIT",
  "name": "stay-awake",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aforemendude/stay-awake.git"
  },
  "scripts": {
    "build": "node scripts/cmake.mjs build",
    "build:debug": "node scripts/cmake.mjs build:debug",
    "build:release": "node scripts/cmake.mjs build:release",
    "test": "node scripts/cmake.mjs test",
    "format": "prettier --write . && node scripts/cmake.mjs format",
    "format:check": "prettier --check . && node scripts/cmake.mjs format-check"
  },
  "version": "1.0.0"
}
